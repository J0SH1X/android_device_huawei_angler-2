# Android fstab file.
#<src>                                         <mnt_point>  <type>  <mnt_flags and options>  <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
           
system       /system         ext4    ro,barrier=1,inode_readahead_blks=8                             wait,first_stage_mount,logical
vendor       /vendor         ext4    ro,barrier=1                             wait,first_stage_mount,logical
product       /product         ext4    ro,barrier=1                             wait,first_stage_mount,logical
/dev/block/by-name/userdata     /data           ext4    noatime,nosuid,nodev,barrier=1,data=ordered,nomblk_io_submit,noauto_da_alloc,errors=continue,inode_readahead_blks=8 wait,check,formattable,latemount
/dev/block/by-name/cache        /cache          ext4    noatime,nosuid,nodev,barrier=1,data=ordered,nomblk_io_submit,noauto_da_alloc,errors=continue wait,check
/dev/block/by-name/persist      /persist        ext4    noatime,nosuid,nodev,barrier=1,data=ordered,nodelalloc,nomblk_io_submit,errors=continue wait,notrim
/dev/block/by-name/modem        /firmware       vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337, wait
/dev/block/by-name/boot         /boot           emmc    defaults                                                        defaults 
/dev/block/by-name/recovery     /recovery       emmc    defaults                                                        defaults
/dev/block/by-name/misc         /misc           emmc    defaults                                                        defaults
/dev/block/by-name/modem        /modem          emmc    defaults                                                        defaults
/dev/block/by-name/sbl1         /sbl1           emmc    defaults                                                        defaults
/dev/block/by-name/pmic         /pmic           emmc    defaults                                                        defaults
/dev/block/by-name/hyp          /hyp            emmc    defaults                                                        defaults
/dev/block/by-name/tz           /tz             emmc    defaults                                                        defaults
/dev/block/by-name/rpm          /rpm            emmc    defaults                                                        defaults
/dev/block/by-name/sdi          /sdi            emmc    defaults                                                        defaults
/dev/block/by-name/aboot        /aboot          emmc    defaults                                                        defaults
#/dev/block/by-name/imgdata     /imgdata        emmc    defaults                                                        defaults
/dev/block/by-name/frp          /persistent     emmc    defaults                                                        defaults
/dev/block/by-name/keymaster    /keymaster      emmc    defaults                                                        defaults
/dev/block/by-name/cmnlib       /cmnlib         emmc    defaults                                                        defaults
/devices/*/xhci-hcd.0.auto/usb*            auto            auto    defaults                                                        voldmanaged=usb:auto
/dev/block/zram0                           none            swap    defaults                                                        zramsize=533413200,notrim
